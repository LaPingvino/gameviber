# GameViber as an Arch package: the gameviber command, the game window (gameviber-run), the desktop launcher
# (gameviber app) and its icon, and GameViber's source in /usr/share/gameviber/src for exports.
#
#   makepkg -si                          from this folder: the latest main from GitHub
#   GAMEVIBER_LOCAL=~/Projects/gameviber makepkg -si   a local checkout instead (its committed HEAD)
pkgname=gameviber-git
pkgver=r0
pkgrel=1
pkgdesc="A GameMaker-style 2D game engine and editor in Go, made for people and coding agents alike"
arch=(x86_64 aarch64)
url="https://github.com/LaPingvino/gameviber"
license=(MIT)
depends=(glibc libx11 libxcursor libxrandr libxinerama libxi libglvnd alsa-lib)
makedepends=(git go)
optdepends=('chromium: the app in a window of its own (or google-chrome, brave, vivaldi, edge)'
            'go: web and desktop export of your games'
            'claude-code: Claude Code in the editor'"'"'s terminal'
            'zenity: a folder picker on the start page (or kdialog)')
provides=(gameviber)
conflicts=(gameviber)
source=("gameviber::git+${GAMEVIBER_LOCAL:-https://github.com/LaPingvino/gameviber.git}")
sha256sums=(SKIP)

pkgver() {
  cd gameviber
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd gameviber
  export CGO_CPPFLAGS="${CPPFLAGS}" CGO_CFLAGS="${CFLAGS}" CGO_CXXFLAGS="${CXXFLAGS}" CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  mkdir -p build
  go build -o build/ ./cmd/gameviber ./cmd/gameviber-run
  for s in 48 64 128 256 512; do
    ./build/gameviber icon $s build/icon-$s.png
  done
}

check() {
  cd gameviber
  ./build/gameviber new build/check-game >/dev/null
  ./build/gameviber check build/check-game
}

package() {
  cd gameviber
  install -Dm755 build/gameviber build/gameviber-run -t "$pkgdir/usr/bin"
  install -Dm644 packaging/gameviber.desktop "$pkgdir/usr/share/applications/gameviber.desktop"
  for s in 48 64 128 256 512; do
    install -Dm644 build/icon-$s.png "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/gameviber.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  # The source, for gameviber web / export (they build the game's player with go): app.go sets GAMEVIBER_SRC.
  install -d "$pkgdir/usr/share/gameviber/src"
  git archive HEAD | tar -x -C "$pkgdir/usr/share/gameviber/src"
}
